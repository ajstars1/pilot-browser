{
  "name": "@pilot-browser/core",
  "version": "0.1.0",
  "description": "Engine-neutral core for pilot-browser: driver contract, interaction lease, overlay, origin policy, risk and taint checks.",
  "keywords": [
    "browser-automation",
    "ai-agent",
    "mcp",
    "cdp",
    "prompt-injection"
  ],
  "license": "Apache-2.0",
  "author": "Ayush Jamwal (https://github.com/ajstars1)",
  "homepage": "https://github.com/ajstars1/pilot-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajstars1/pilot-browser.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ajstars1/pilot-browser/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
