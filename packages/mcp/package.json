{
  "name": "@pilot-browser/mcp",
  "version": "0.0.0",
  "description": "MCP server that lets AI agents drive your real, logged-in browser with a visible cursor and an origin allowlist.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pilot-browser-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
