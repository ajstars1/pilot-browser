{
  "name": "pilot-browser-monorepo",
  "private": true,
  "description": "Let AI agents drive your real, logged-in browser \u2014 with a visible cursor, approvals and human takeover. MCP-native.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
