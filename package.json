{
  "name": "pilot-browser-monorepo",
  "private": true,
  "description": "Let AI agents drive your real, logged-in browser \u2014 with a visible cursor, approvals and human takeover. MCP-native.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pilot-browser/core -w @pilot-browser/driver-agent-browser -w @pilot-browser/mcp",
    "typecheck": "npm run typecheck -w @pilot-browser/core -w @pilot-browser/driver-agent-browser -w @pilot-browser/mcp",
    "test": "npm run test --workspaces --if-present",
    "spike:managed": "node spike/run-managed.mjs",
    "spike:attach": "node spike/run-attach.mjs",
    "test:e2e": "npm run build && PILOT_E2E=1 npm test",
    "demo:record": "npm run build && node scripts/record-demo.mts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "agent-browser": "0.38.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajstars1/pilot-browser.git"
  }
}
