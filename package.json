    "test": "npm run test --workspaces --if-present",
    "spike:managed": "node spike/run-managed.mjs",
    "spike:attach": "node spike/run-attach.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "agent-browser": "0.38.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
